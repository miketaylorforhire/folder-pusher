{
  "name": "folderpusher",
  "version": "0.1.21",
  "description": "Copy one source folder to many destination machines on a LAN, using robocopy with skip-existing semantics.",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "icon": "node scripts/build-icon.mjs",
    "package": "node scripts/prepare-wincodesign.mjs && node scripts/build-installer.mjs",
    "release": "node scripts/release.mjs",
    "cert:generate": "node scripts/generate-signing-cert.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "jszip": "^3.10.1",
    "sharp": "^0.34.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  },
  "build": {
    "appId": "com.folderpusher.app",
    "productName": "FolderPusher",
    "asar": true,
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "executableName": "FolderPusher",
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    }
  }
}
